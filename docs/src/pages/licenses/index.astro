---
import Site from "../../layouts/Site.astro";
import { render } from "astro:content";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { marked } from "marked";

// licenses/index.md has no frontmatter and is excluded from the collection;
// render it in place.
const raw = await readFile(resolve(process.cwd(), "licenses/index.md"), "utf8");
const html = await marked.parse(raw);
const title = raw.match(/^# (.+)$/m)?.[1] ?? "Font License Guide";
---
<Site title={`${title} — Fontist Formulas`} description="How to read font licenses for practical use cases">
  <article class="prose doc-page" set:html={html} />
</Site>
