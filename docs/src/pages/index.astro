---
import Site from "../layouts/Site.astro";
import HomeSearch from "../components/HomeSearch.vue";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

// Regenerated by `node generate.js` before every build (prebuild hook).
const statsPath = resolve(process.cwd(), "public/stats.json");
const stats = JSON.parse(await readFile(statsPath, "utf8"));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const num = (n) => Number(n ?? 0).toLocaleString();
---
<Site title="Fontist Formulas" description="Searchable index of all Fontist Formulas">
  <div class="formulas-index">
    <HomeSearch client:load stats={stats} />

    <section class="browse-section">
      <h2 class="section-title">Browse by License</h2>
      <div class="card-grid">
        <a href={`${base}/browse/?license=open_source`} class="browse-card">
          <img src={`${base}/licenses/open.svg`} alt="Open Source" class="card-icon-img" />
          <span class="card-title">Open Source</span>
          <span class="card-count">{num(stats.licenses.open_source)}+</span>
        </a>
        <a href={`${base}/browse/?license=freely_distributable`} class="browse-card">
          <img src={`${base}/licenses/freely-distributed.svg`} alt="Freely Distributable" class="card-icon-img" />
          <span class="card-title">Freely Distributable</span>
          <span class="card-count">{num(stats.licenses.freely_distributable)}+</span>
        </a>
        <a href={`${base}/browse/?license=platform_restricted`} class="browse-card">
          <img src={`${base}/licenses/platform-tied.svg`} alt="Platform Tied" class="card-icon-img" />
          <span class="card-title">Platform Restricted</span>
          <span class="card-count">{num(stats.licenses.platform_restricted)}+</span>
        </a>
        <a href={`${base}/browse/?license=bundled_software`} class="browse-card">
          <img src={`${base}/licenses/bundled.svg`} alt="Bundled Software" class="card-icon-img" />
          <span class="card-title">Bundled Software</span>
          <span class="card-count">{num(stats.licenses.bundled_software)}+</span>
        </a>
      </div>
    </section>

    <section class="browse-section">
      <h2 class="section-title">Browse by Source</h2>
      <div class="card-grid">
        <a href={`${base}/browse/?source=google`} class="browse-card source-card">
          <img src={`${base}/sources/google.svg`} alt="Google Fonts" class="card-icon-img" />
          <span class="card-title">Google Fonts</span>
          <span class="card-count">{num(stats.sources.google)}+</span>
        </a>
        <a href={`${base}/browse/?source=sil`} class="browse-card source-card">
          <img src={`${base}/sources/sil.svg`} alt="SIL International" class="card-icon-img" />
          <span class="card-title">SIL International</span>
          <span class="card-count">{num(stats.sources.sil)}+</span>
        </a>
        <a href={`${base}/browse/?source=macos`} class="browse-card source-card">
          <img src={`${base}/sources/apple.svg`} alt="Apple" class="card-icon-img" />
          <span class="card-title">Apple</span>
          <span class="card-count">{num(stats.sources.macos)}+</span>
        </a>
        <a href={`${base}/browse/?source=manual`} class="browse-card source-card">
          <img src={`${base}/sources/fontist.svg`} alt="Expert Curated" class="card-icon-img" />
          <span class="card-title">Expert Curated</span>
          <span class="card-count">{num(stats.sources.manual)}+</span>
        </a>
      </div>
    </section>

    <div class="quick-install-section">
      <div class="quick-install">
        <code class="install-cmd">fontist install "roboto"</code>
        <button type="button" id="install-copy" class="copy-btn">Copy</button>
      </div>
    </div>

    <div class="index-footer">
      <a href={`${base}/browse/`} class="footer-link primary">View all formulas →</a>
      <div class="footer-links">
        <a href={`${base}/guide/`} class="footer-link">Guide</a>
        <a href={`${base}/licenses/`} class="footer-link">Licenses</a>
        <a href="https://github.com/fontist/formulas" target="_blank" class="footer-link">GitHub</a>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById("install-copy")?.addEventListener("click", (e) => {
      navigator.clipboard.writeText('fontist install "roboto"');
      const btn = e.currentTarget;
      btn.textContent = "Copied!";
      btn.classList.add("copied");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("copied");
      }, 2000);
    });
  </script>
</Site>
